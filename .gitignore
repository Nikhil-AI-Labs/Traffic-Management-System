# --------------------------------------------------------------------------
# Datasets — never committed
# --------------------------------------------------------------------------
# The Surat CCTV exports (~800 MB) are the problem statement's own data and are
# not ours to redistribute. FLUID is 19 GB and is a published dataset with its
# own DOI. Both are fetched separately; see the README.
*.avi
*.mp4
*.mov
*.mkv
29974954/
Dataset_Multi-perspective*/
Gauravpath/
Export__*
*.docx

# --------------------------------------------------------------------------
# Model weights — fetched by scripts/download_models.py
# --------------------------------------------------------------------------
models/
*.pt
*.onnx
*.engine

# --------------------------------------------------------------------------
# Generated outputs
# --------------------------------------------------------------------------
# outputs/logs/*.csv IS committed — it is what makes the dashboard runnable
# without the source video, and it is under 1 MB. Everything else here is
# regenerated by the pipeline and is either large or machine-specific.
outputs/annotated/
outputs/uploads/
outputs/fluid_cache/
outputs/frames/heatmap/
outputs/frames/calibration/
outputs/frames/measurement_guide/
outputs/frames/*.jpg
# The grid-overlaid copies exist only for reading pixel coordinates by hand
# during manual calibration, and are regenerated by reference_frames.py.
outputs/frames/reference/*_grid.jpg
outputs/**/*.mp4

# Runtime calibration state is per-deployment, not source.
configs/calibration_state.json

# --------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# --------------------------------------------------------------------------
# Editors / OS
# --------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Windows reserved-name artifact from a stray `2>NUL` redirect; git
# cannot index it.
NUL

# Uploads kept alongside the dataset are per-machine state.
configs/uploaded_cameras*.json
outputs/logs/upload_*_metrics.csv

# React front end: dependencies and build output are regenerated by npm.
web/node_modules/
web/dist/

# Control-room state: who acknowledged and resolved which incident.
outputs/incidents.json

# OpenVINO export of the detector (python scripts/export_openvino.py).
models/weights/*/*_openvino_model/

# Intel GPU compiler diagnostics, written to the working directory when
# OpenVINO compiles the detector for the integrated GPU.
kernel.errors.txt
